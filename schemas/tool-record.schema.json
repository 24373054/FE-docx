{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/tool-record.schema.json",
  "title": "Validated Tool Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool_id",
    "name",
    "version",
    "artifact_sha256",
    "intended_use",
    "validation_record_id",
    "approval_status"
  ],
  "properties": {
    "tool_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "intended_use": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "prohibited_use": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "os",
        "dependencies"
      ],
      "properties": {
        "os": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "validation_record_id": {
      "type": "string"
    },
    "approval_status": {
      "enum": [
        "production",
        "limited",
        "experimental",
        "rejected",
        "retired"
      ]
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
