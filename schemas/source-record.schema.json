{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/source-record.schema.json",
  "title": "Controlled Data Source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "source_type",
    "name",
    "trust_level",
    "allowed_uses",
    "version_checked_at"
  ],
  "properties": {
    "source_id": {
      "type": "string"
    },
    "source_type": {
      "enum": [
        "self-hosted-node",
        "secondary-client",
        "third-party-rpc",
        "block-explorer",
        "official-web",
        "supplier-label",
        "provided-file",
        "device"
      ]
    },
    "name": {
      "type": "string"
    },
    "network": {
      "type": [
        "string",
        "null"
      ]
    },
    "client_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "trust_level": {
      "enum": [
        "primary",
        "corroborating",
        "lead-only",
        "prohibited"
      ]
    },
    "allowed_uses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "prohibited_uses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "version_checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "health": {
      "type": "object",
      "properties": {
        "height": {
          "type": [
            "integer",
            "null"
          ]
        },
        "synced": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "latency_ms": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "license_record_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
