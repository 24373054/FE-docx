{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/evidence-manifest.schema.json",
  "title": "Evidence Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "case_id",
    "created_at",
    "created_by",
    "objects",
    "root_hash"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^3\\.[0-9]+\\.[0-9]+$"
    },
    "package_id": {
      "type": "string",
      "minLength": 8
    },
    "case_id": {
      "type": "string",
      "minLength": 4
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string",
      "minLength": 2
    },
    "classification": {
      "enum": [
        "public",
        "internal",
        "sensitive-case",
        "restricted"
      ]
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object_id",
          "object_type",
          "path",
          "sha256",
          "size_bytes",
          "source_id"
        ],
        "properties": {
          "object_id": {
            "type": "string"
          },
          "object_type": {
            "enum": [
              "raw",
              "derived",
              "normalized",
              "display",
              "record",
              "report"
            ]
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "source_id": {
            "type": "string"
          },
          "parent_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tool_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "method_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "root_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "signer",
          "algorithm",
          "signature"
        ],
        "properties": {
          "signer": {
            "type": "string"
          },
          "algorithm": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          }
        }
      }
    }
  }
}
